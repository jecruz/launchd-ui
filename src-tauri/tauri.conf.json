{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Daemonic",
  "version": "1.2.1",
  "identifier": "com.github.azu.daemonic",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Daemonic",
        "width": 1200,
        "height": 940,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
